{
  "name": "lgdeck",
  "version": "0.1.0",
  "description": "A self-hosted flashcard app for learning languages, with your own alphabets and an on-screen keyboard.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "esbuild": "0.25.12",
    "hono": "4.13.16",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "main": "server.cjs"
}
